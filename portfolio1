    <script>
        // Simulated Glyph wallet integration
        // In production, this would use the actual Glyph SDK
        
        function handleLogin(e) {
            e.preventDefault();
            const email = e.target.querySelector('input').value;
            
            // Show loading state
            const btn = e.target.querySelector('button');
            const originalText = btn.textContent;
            btn.textContent = 'Sender...';
            btn.disabled = true;
            
            // Simulate Glyph wallet email magic link
            setTimeout(() => {
                alert(`Vi har sendt et login link til ${email}\n\nTjek din indbakke!`);
                btn.textContent = originalText;
                btn.disabled = false;
                e.target.reset();
            }, 1500);
            
            // In production:
            // glyphWallet.sendMagicLink(email).then(() => { ... })
        }

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
    </script>
